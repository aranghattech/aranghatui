{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sandbox": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "node_modules/@aranghat/tokens/dist/css/aranghat.css",
              "src/sandbox.css"
            ],
            "sourceMap": true,
            "optimization": true,
            "outputHashing": "none",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "conditions": [
              "artui-ssr"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "sandbox:build"
          }
        }
      }
    }
  }
}
