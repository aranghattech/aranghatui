{
  "name": "@aranghat/primitives",
  "version": "0.0.0",
  "description": "artui headless primitives — shared behaviour for every tier (positioning, dismissal, focus, roving tabindex, portal, typeahead, ids, events).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./define": { "types": "./dist/define/index.d.ts", "import": "./dist/define/index.js" },
    "./id": { "types": "./dist/id/index.d.ts", "import": "./dist/id/index.js" },
    "./events": { "types": "./dist/events/index.d.ts", "import": "./dist/events/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@aranghat/tokens": "workspace:*"
  },
  "devDependencies": {
    "@aranghat/tokens": "workspace:*",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
