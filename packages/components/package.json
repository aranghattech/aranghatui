{
  "name": "@aranghat/components",
  "version": "0.0.0",
  "description": "artui Tier 3 — composite components (overlays, disclosure, selection, dates, feedback).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": "./dist/components/*",
    "./accordion": {
      "types": "./dist/components/art-accordion.d.ts",
      "import": "./dist/components/art-accordion.js"
    },
    "./accordion-item": {
      "types": "./dist/components/art-accordion-item.d.ts",
      "import": "./dist/components/art-accordion-item.js"
    },
    "./alert": {
      "types": "./dist/components/art-alert.d.ts",
      "import": "./dist/components/art-alert.js"
    },
    "./avatar": {
      "types": "./dist/components/art-avatar.d.ts",
      "import": "./dist/components/art-avatar.js"
    },
    "./collapsible": {
      "types": "./dist/components/art-collapsible.d.ts",
      "import": "./dist/components/art-collapsible.js"
    },
    "./combobox": {
      "types": "./dist/components/art-combobox.d.ts",
      "import": "./dist/components/art-combobox.js"
    },
    "./combobox-group": {
      "types": "./dist/components/art-combobox-group.d.ts",
      "import": "./dist/components/art-combobox-group.js"
    },
    "./combobox-item": {
      "types": "./dist/components/art-combobox-item.d.ts",
      "import": "./dist/components/art-combobox-item.js"
    },
    "./command": {
      "types": "./dist/components/art-command.d.ts",
      "import": "./dist/components/art-command.js"
    },
    "./command-group": {
      "types": "./dist/components/art-command-group.d.ts",
      "import": "./dist/components/art-command-group.js"
    },
    "./command-item": {
      "types": "./dist/components/art-command-item.d.ts",
      "import": "./dist/components/art-command-item.js"
    },
    "./hover-card": {
      "types": "./dist/components/art-hover-card.d.ts",
      "import": "./dist/components/art-hover-card.js"
    },
    "./popover": {
      "types": "./dist/components/art-popover.d.ts",
      "import": "./dist/components/art-popover.js"
    },
    "./resizable": {
      "types": "./dist/components/art-resizable.d.ts",
      "import": "./dist/components/art-resizable.js"
    },
    "./resizable-handle": {
      "types": "./dist/components/art-resizable-handle.d.ts",
      "import": "./dist/components/art-resizable-handle.js"
    },
    "./resizable-panel": {
      "types": "./dist/components/art-resizable-panel.d.ts",
      "import": "./dist/components/art-resizable-panel.js"
    },
    "./scroll-area": {
      "types": "./dist/components/art-scroll-area.d.ts",
      "import": "./dist/components/art-scroll-area.js"
    },
    "./select": {
      "types": "./dist/components/art-select.d.ts",
      "import": "./dist/components/art-select.js"
    },
    "./select-group": {
      "types": "./dist/components/art-select-group.d.ts",
      "import": "./dist/components/art-select-group.js"
    },
    "./select-item": {
      "types": "./dist/components/art-select-item.d.ts",
      "import": "./dist/components/art-select-item.js"
    },
    "./tab": {
      "types": "./dist/components/art-tab.d.ts",
      "import": "./dist/components/art-tab.js"
    },
    "./tab-panel": {
      "types": "./dist/components/art-tab-panel.d.ts",
      "import": "./dist/components/art-tab-panel.js"
    },
    "./tabs": {
      "types": "./dist/components/art-tabs.d.ts",
      "import": "./dist/components/art-tabs.js"
    },
    "./tooltip": {
      "types": "./dist/components/art-tooltip.d.ts",
      "import": "./dist/components/art-tooltip.js"
    },
    "./docs.json": "./dist/docs.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist www && stencil build --docs && artui-wrapper-entries core components",
    "dev": "ARTUI_BUNDLE_PEERS=1 stencil build --dev --watch --serve",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*"
  },
  "devDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*",
    "@artui/e2e": "workspace:*",
    "@artui/stencil-config": "workspace:*",
    "@artui/stories": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "@playwright/test": "1.63.0",
    "@stencil/core": "4.45.0",
    "@stencil/playwright": "0.5.1",
    "@stencil/vitest": "1.15.1",
    "jsdom": "28.1.0",
    "vitest": "4.1.11"
  }
}
