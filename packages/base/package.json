    "./typography": {
      "types": "./dist/components/art-typography.d.ts",
      "import": "./dist/components/art-typography.js"
    },
    "./docs.json": "./dist/docs.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist www && stencil build --docs && artui-wrapper-entries core base",
    "dev": "ARTUI_BUNDLE_PEERS=1 stencil build --dev --watch --serve",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@aranghat/icons": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*"
  },
