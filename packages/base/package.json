{
  "name": "@aranghat/base",
  "version": "0.0.0",
  "description": "artui Tier 2 — base web components (native form controls and atoms).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components": {
