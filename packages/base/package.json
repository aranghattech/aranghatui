    "./textarea": {
      "types": "./dist/components/art-textarea.d.ts",
      "import": "./dist/components/art-textarea.js"
    },
    "./toggle": {
      "types": "./dist/components/art-toggle.d.ts",
      "import": "./dist/components/art-toggle.js"
    },
    "./toggle-group": {
      "types": "./dist/components/art-toggle-group.d.ts",
