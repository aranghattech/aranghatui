    "./field-set": {
      "types": "./dist/components/art-field-set.d.ts",
      "import": "./dist/components/art-field-set.js"
    },
    "./icon": {
      "types": "./dist/components/art-icon.d.ts",
      "import": "./dist/components/art-icon.js"
