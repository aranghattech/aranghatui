{
  "name": "@aranghat/modals",
  "version": "0.0.0",
  "description": "artui Tier 5 — modals and overlays.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "artui-ssr": "./dist/components-ssr/index.js",
      "import": "./dist/components/index.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "artui-ssr": "./dist/components-ssr/index.js",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": {
      "types": "./dist/components/*",
      "artui-ssr": "./dist/components-ssr/*",
      "default": "./dist/components/*"
    },
    "./alert-dialog": {
      "types": "./dist/components/art-alert-dialog.d.ts",
      "artui-ssr": "./dist/components-ssr/art-alert-dialog.js",
      "import": "./dist/components/art-alert-dialog.js"
    },
    "./dialog": {
      "types": "./dist/components/art-dialog.d.ts",
      "artui-ssr": "./dist/components-ssr/art-dialog.js",
      "import": "./dist/components/art-dialog.js"
    },
    "./drawer": {
      "types": "./dist/components/art-drawer.d.ts",
      "artui-ssr": "./dist/components-ssr/art-drawer.js",
      "import": "./dist/components/art-drawer.js"
    },
    "./sheet": {
      "types": "./dist/components/art-sheet.d.ts",
      "artui-ssr": "./dist/components-ssr/art-sheet.js",
      "import": "./dist/components/art-sheet.js"
    },
    "./docs.json": "./dist/docs.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist www && stencil build --docs && ARTUI_SSR=1 stencil build && rm -rf dist/hydrate && artui-wrapper-entries core modals",
    "dev": "ARTUI_BUNDLE_PEERS=1 stencil build --dev --watch --serve",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*"
  },
  "devDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*",
    "@artui/e2e": "workspace:*",
    "@artui/stencil-config": "workspace:*",
    "@artui/stories": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "@playwright/test": "1.63.0",
    "@stencil/core": "4.45.0",
    "@stencil/playwright": "0.5.1",
    "@stencil/vitest": "1.15.1",
    "jsdom": "28.1.0",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
