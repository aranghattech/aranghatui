{
  "name": "@aranghat/navigation",
  "version": "0.0.0",
  "description": "artui Tier 4 — navigation (breadcrumb, pagination, menus, sidebar, tree).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": "./dist/components/*",
    "./breadcrumb": {
      "types": "./dist/components/art-breadcrumb.d.ts",
      "import": "./dist/components/art-breadcrumb.js"
    },
    "./breadcrumb-item": {
      "types": "./dist/components/art-breadcrumb-item.d.ts",
      "import": "./dist/components/art-breadcrumb-item.js"
    },
    "./dropdown-menu": {
      "types": "./dist/components/art-dropdown-menu.d.ts",
      "import": "./dist/components/art-dropdown-menu.js"
    },
    "./menu-group": {
      "types": "./dist/components/art-menu-group.d.ts",
      "import": "./dist/components/art-menu-group.js"
    },
    "./menu-item": {
      "types": "./dist/components/art-menu-item.d.ts",
      "import": "./dist/components/art-menu-item.js"
    },
    "./menu-label": {
      "types": "./dist/components/art-menu-label.d.ts",
      "import": "./dist/components/art-menu-label.js"
    },
    "./menu-radio-group": {
      "types": "./dist/components/art-menu-radio-group.d.ts",
      "import": "./dist/components/art-menu-radio-group.js"
    },
    "./menu-separator": {
      "types": "./dist/components/art-menu-separator.d.ts",
      "import": "./dist/components/art-menu-separator.js"
    },
    "./menu-sub": {
      "types": "./dist/components/art-menu-sub.d.ts",
      "import": "./dist/components/art-menu-sub.js"
    },
    "./pagination": {
      "types": "./dist/components/art-pagination.d.ts",
      "import": "./dist/components/art-pagination.js"
    },
    "./docs.json": "./dist/docs.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist www && stencil build --docs && artui-wrapper-entries core navigation",
    "dev": "ARTUI_BUNDLE_PEERS=1 stencil build --dev --watch --serve",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*"
  },
  "devDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*",
    "@artui/e2e": "workspace:*",
    "@artui/stencil-config": "workspace:*",
    "@artui/stories": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "@playwright/test": "1.63.0",
    "@stencil/core": "4.45.0",
    "@stencil/playwright": "0.5.1",
    "@stencil/vitest": "1.15.1",
    "jsdom": "28.1.0",
    "vitest": "4.1.11"
  }
}
