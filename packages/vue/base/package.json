{
  "name": "@aranghat/base-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for @aranghat/base — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./hello": {
      "types": "./dist/hello.d.ts",
      "import": "./dist/hello.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "import": "./dist/label.js"
    },
    "./native-select": {
      "types": "./dist/native-select.d.ts",
      "import": "./dist/native-select.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "import": "./dist/radio-group.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "import": "./dist/toggle.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group.d.ts",
      "import": "./dist/toggle-group.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue base && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "@aranghat/base": "workspace:*",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@aranghat/base": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  }
}
