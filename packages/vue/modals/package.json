{
  "name": "@aranghat/modals-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for @aranghat/modals — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hello-overlay": {
      "types": "./dist/hello-overlay.d.ts",
      "import": "./dist/hello-overlay.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue modals && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "@aranghat/modals": "workspace:*",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@aranghat/modals": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  }
}
