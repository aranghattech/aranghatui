{
  "name": "@aranghat/modals-vue",
  "version": "1.0.0",
  "description": "Vue 3 bindings for @aranghat/modals — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog.d.ts",
      "import": "./dist/alert-dialog.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue modals && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/modals": "workspace:*",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/modals": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  },
  "peerDependenciesMeta": {
    "@aranghat/hydrate": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
