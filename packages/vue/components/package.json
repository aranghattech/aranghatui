{
  "name": "@aranghat/components-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for @aranghat/components — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hover-card": {
      "types": "./dist/hover-card.d.ts",
      "import": "./dist/hover-card.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue components && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "@aranghat/components": "workspace:*",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@aranghat/components": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  }
}
