{
  "name": "@aranghat/navigation-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for @aranghat/navigation — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb.d.ts",
      "import": "./dist/breadcrumb.js"
    },
    "./breadcrumb-item": {
      "types": "./dist/breadcrumb-item.d.ts",
      "import": "./dist/breadcrumb-item.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "import": "./dist/dropdown-menu.js"
    },
    "./dropdown-menu-group": {
      "types": "./dist/dropdown-menu-group.d.ts",
      "import": "./dist/dropdown-menu-group.js"
    },
    "./dropdown-menu-item": {
      "types": "./dist/dropdown-menu-item.d.ts",
      "import": "./dist/dropdown-menu-item.js"
    },
    "./dropdown-menu-label": {
      "types": "./dist/dropdown-menu-label.d.ts",
      "import": "./dist/dropdown-menu-label.js"
    },
    "./dropdown-menu-radio-group": {
      "types": "./dist/dropdown-menu-radio-group.d.ts",
      "import": "./dist/dropdown-menu-radio-group.js"
    },
    "./dropdown-menu-separator": {
      "types": "./dist/dropdown-menu-separator.d.ts",
      "import": "./dist/dropdown-menu-separator.js"
    },
    "./dropdown-menu-sub": {
      "types": "./dist/dropdown-menu-sub.d.ts",
      "import": "./dist/dropdown-menu-sub.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue navigation && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "vue": "^3.4.38",
    "@aranghat/navigation": "workspace:*"
  },
  "devDependencies": {
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42",
    "@aranghat/navigation": "workspace:*"
  }
}
