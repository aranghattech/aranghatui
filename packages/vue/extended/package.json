{
  "name": "@aranghat/extended-vue",
  "version": "1.0.1",
  "description": "Vue 3 bindings for @aranghat/extended — generated by Stencil's Vue output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mega-menu": {
      "types": "./dist/mega-menu.d.ts",
      "import": "./dist/mega-menu.js"
    },
    "./mega-menu-group": {
      "types": "./dist/mega-menu-group.d.ts",
      "import": "./dist/mega-menu-group.js"
    },
    "./mega-menu-item": {
      "types": "./dist/mega-menu-item.d.ts",
      "import": "./dist/mega-menu-item.js"
    },
    "./mega-menu-link": {
      "types": "./dist/mega-menu-link.d.ts",
      "import": "./dist/mega-menu-link.js"
    },
    "./nav-link": {
      "types": "./dist/nav-link.d.ts",
      "import": "./dist/nav-link.js"
    },
    "./nav-rail": {
      "types": "./dist/nav-rail.d.ts",
      "import": "./dist/nav-rail.js"
    },
    "./nav-rail-item": {
      "types": "./dist/nav-rail-item.d.ts",
      "import": "./dist/nav-rail-item.js"
    },
    "./nav-section": {
      "types": "./dist/nav-section.d.ts",
      "import": "./dist/nav-section.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries vue extended && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "0.14.3"
  },
  "peerDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  },
  "peerDependenciesMeta": {
    "@aranghat/hydrate": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
