{
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem"
    },
    "none": {
      "$value": "0rem"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "$value": "1px"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "180ms"
    },
    "slow": {
      "$value": "240ms"
    },
    "spin": {
      "$value": "1000ms",
      "$description": "Loading spinner revolution."
    },
    "pulse": {
      "$value": "2000ms",
      "$description": "Skeleton shimmer cycle."
    },
    "caret-blink": {
      "$value": "1200ms",
      "$description": "Fake caret blink in segmented inputs (Input OTP)."
    },
    "hover-open": {
      "$value": "300ms",
      "$description": "Hover intent before a tooltip / hover card opens."
    },
    "hover-close": {
      "$value": "150ms",
      "$description": "Grace period after the pointer leaves before a tooltip closes."
    },
    "hover-card-open": {
      "$value": "700ms",
      "$description": "Hover intent before a hover card opens (slower than a tooltip: it is content, not a label)."
    },
    "hover-card-close": {
      "$value": "300ms",
      "$description": "Grace period after the pointer leaves a hover card or its trigger."
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "in-out": {
      "$value": [
        0.65,
        0,
        0.35,
        1
      ]
    },
    "linear": {
      "$value": [
        0,
        0,
        1,
        1
      ]
    }
  },
  "z": {
    "$type": "number",
    "dropdown": {
      "$value": 50
    },
    "sticky": {
      "$value": 100
    },
    "overlay": {
      "$value": 200
    },
    "modal": {
      "$value": 300
    },
    "toast": {
      "$value": 400
    }
  }
}
