{
  "name": "@aranghat/extended-react",
  "version": "0.0.0",
  "description": "React bindings for @aranghat/extended — generated by Stencil's React output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nav-link": {
      "types": "./dist/nav-link.d.ts",
      "import": "./dist/nav-link.js"
    },
    "./nav-rail": {
      "types": "./dist/nav-rail.d.ts",
      "import": "./dist/nav-rail.js"
    },
    "./nav-rail-item": {
      "types": "./dist/nav-rail-item.d.ts",
      "import": "./dist/nav-rail-item.js"
    },
    "./nav-section": {
      "types": "./dist/nav-section.d.ts",
      "import": "./dist/nav-section.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries react extended && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "1.6.2"
  },
  "peerDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@aranghat/hydrate": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "@aranghat/hydrate": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
