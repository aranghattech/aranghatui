{
  "name": "@aranghat/widgets-react",
  "version": "0.0.0",
  "description": "React bindings for @aranghat/widgets — generated by Stencil's React output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app-shell": {
      "types": "./dist/app-shell.d.ts",
      "import": "./dist/app-shell.js"
    },
    "./data-table-page": {
      "types": "./dist/data-table-page.d.ts",
      "import": "./dist/data-table-page.js"
    },
    "./forgot-password": {
      "types": "./dist/forgot-password.d.ts",
      "import": "./dist/forgot-password.js"
    },
    "./login": {
      "types": "./dist/login.d.ts",
      "import": "./dist/login.js"
    },
    "./notification-centre": {
      "types": "./dist/notification-centre.d.ts",
      "import": "./dist/notification-centre.js"
    },
    "./notification-item": {
      "types": "./dist/notification-item.d.ts",
      "import": "./dist/notification-item.js"
    },
    "./onboarding-wizard": {
      "types": "./dist/onboarding-wizard.d.ts",
      "import": "./dist/onboarding-wizard.js"
    },
    "./settings-page": {
      "types": "./dist/settings-page.d.ts",
      "import": "./dist/settings-page.js"
    },
    "./signup": {
      "types": "./dist/signup.d.ts",
      "import": "./dist/signup.js"
    },
    "./state-page": {
      "types": "./dist/state-page.d.ts",
      "import": "./dist/state-page.js"
    },
    "./wizard-step": {
      "types": "./dist/wizard-step.d.ts",
      "import": "./dist/wizard-step.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries react widgets && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "1.6.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@aranghat/widgets": "workspace:*"
  },
  "devDependencies": {
    "@artui/wrapper-entries": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "@aranghat/widgets": "workspace:*"
  }
}
