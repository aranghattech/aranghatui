{
  "name": "@aranghat/navigation-react",
  "version": "0.0.0",
  "description": "React bindings for @aranghat/navigation — generated by Stencil's React output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb.d.ts",
      "import": "./dist/breadcrumb.js"
    },
    "./breadcrumb-item": {
      "types": "./dist/breadcrumb-item.d.ts",
      "import": "./dist/breadcrumb-item.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "import": "./dist/dropdown-menu.js"
    },
    "./menu-group": {
      "types": "./dist/menu-group.d.ts",
      "import": "./dist/menu-group.js"
    },
    "./menu-item": {
      "types": "./dist/menu-item.d.ts",
      "import": "./dist/menu-item.js"
    },
    "./menu-label": {
      "types": "./dist/menu-label.d.ts",
      "import": "./dist/menu-label.js"
    },
    "./menu-radio-group": {
      "types": "./dist/menu-radio-group.d.ts",
      "import": "./dist/menu-radio-group.js"
    },
    "./menu-separator": {
      "types": "./dist/menu-separator.d.ts",
      "import": "./dist/menu-separator.js"
    },
    "./menu-sub": {
      "types": "./dist/menu-sub.d.ts",
      "import": "./dist/menu-sub.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries react navigation && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "1.6.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@aranghat/navigation": "workspace:*"
  },
  "devDependencies": {
    "@artui/wrapper-entries": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "@aranghat/navigation": "workspace:*"
  }
}
