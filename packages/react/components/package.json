{
  "name": "@aranghat/components-react",
  "version": "0.0.0",
  "description": "React bindings for @aranghat/components — generated by Stencil's React output target (never hand-written).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js"
    },
    "./accordion-item": {
      "types": "./dist/accordion-item.d.ts",
      "import": "./dist/accordion-item.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "import": "./dist/collapsible.js"
    },
    "./hover-card": {
      "types": "./dist/hover-card.d.ts",
      "import": "./dist/hover-card.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./resizable": {
      "types": "./dist/resizable.d.ts",
      "import": "./dist/resizable.js"
    },
    "./resizable-handle": {
      "types": "./dist/resizable-handle.d.ts",
      "import": "./dist/resizable-handle.js"
    },
    "./resizable-panel": {
      "types": "./dist/resizable-panel.d.ts",
      "import": "./dist/resizable-panel.js"
    },
    "./scroll-area": {
      "types": "./dist/scroll-area.d.ts",
      "import": "./dist/scroll-area.js"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.js"
    },
    "./tab-panel": {
      "types": "./dist/tab-panel.d.ts",
      "import": "./dist/tab-panel.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "artui-wrapper-entries react components && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "1.6.2"
  },
  "peerDependencies": {
    "@aranghat/components": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@aranghat/components": "workspace:*",
    "@artui/wrapper-entries": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
