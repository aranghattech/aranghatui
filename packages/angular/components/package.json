{
  "name": "@aranghat/components-angular",
  "version": "1.1.0",
  "description": "Angular bindings for @aranghat/components — standalone proxies generated by Stencil's Angular output target (never hand-written).",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "artui-wrapper-entries angular components && ng-packagr -p ng-package.json -c tsconfig.lib.json && node ../../../scripts/sync-angular-exports.mjs ."
  },
  "peerDependencies": {
    "@aranghat/components": "workspace:*",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "devDependencies": {
    "@aranghat/components": "workspace:*",
    "@angular/compiler": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@artui/wrapper-entries": "workspace:*",
    "ng-packagr": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "zone.js": "0.16.0"
  },
  "module": "fesm2022/aranghat-components-angular.mjs",
  "typings": "types/aranghat-components-angular.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/aranghat-components-angular.d.ts",
      "default": "./dist/fesm2022/aranghat-components-angular.mjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
