{
  "name": "@aranghat/ui",
  "version": "1.0.1",
  "description": "artui meta-package \u2014 every tier in one import. The 'just get me started' option: it costs the bundle size of every tier you do not use; prefer the per-tier packages (CLAUDE.md \u00a72).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/components": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "@aranghat/modals": "workspace:*",
    "@aranghat/navigation": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*",
    "@aranghat/widgets": "workspace:*"
  },
  "devDependencies": {
    "@aranghat/base": "workspace:*",
    "@aranghat/components": "workspace:*",
    "@aranghat/extended": "workspace:*",
    "@aranghat/modals": "workspace:*",
    "@aranghat/navigation": "workspace:*",
    "@aranghat/primitives": "workspace:*",
    "@aranghat/tokens": "workspace:*",
    "@aranghat/widgets": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
